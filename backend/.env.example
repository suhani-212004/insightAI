ENV=dev

# Postgres: app role + read-only role (created by docker/postgres/init.sql)
DATABASE_URL=postgresql+psycopg2://insight:insight@localhost:5432/insight
READONLY_DATABASE_URL=postgresql+psycopg2://insight_readonly:insight_ro@localhost:5432/insight

REDIS_URL=redis://localhost:6379/0

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# AI (Text-to-SQL). Without a key the chat returns sample rows instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (test mode). Without these, use the "dev plan switch" on the Settings page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
