ENV=dev

# Postgres: app role + read-only role (created by docker/postgres/init.sql)
DATABASE_URL=postgresql+psycopg2://insight:insight@localhost:5432/insight
READONLY_DATABASE_URL=postgresql+psycopg2://insight_readonly:insight_ro@localhost:5432/insight

REDIS_URL=redis://localhost:6379/0

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# AI (Text-to-SQL). Without a key the chat returns sample rows instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (test mode). Without these, use the "dev plan switch" on the Settings page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Scaling. Keep (API processes + workers) x (pool + overflow) below Postgres max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_READONLY_POOL_SIZE=5
REDIS_MAX_CONNECTIONS=500

# Limits
MAX_UPLOAD_MB=25
MAX_WEBHOOK_KB=1024
# Dev only: let API connectors poll localhost / LAN URLs
ALLOW_PRIVATE_CONNECTOR_URLS=false

# Groq (OpenAI-compatible, free tier).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama (Local LLM - e.g. llama3:latest).
USE_OLLAMA=false
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3:latest
